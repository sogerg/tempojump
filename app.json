{
  "expo": {
    "name": "TempoJump",
    "slug": "mon-appli-cavalier",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sogerg.monappcavalier",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "20"
    },
    "android": {
      "package": "com.sogerg.monappcavalier",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0A2844",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Autorise l'accès à la caméra pour photographier les plans de parcours et filmer tes reprises.",
          "microphonePermission": "Autorise l'accès au micro pour filmer tes reprises avec le son.",
          "photosPermission": "Autorise l'accès à tes photos pour choisir un plan de parcours ou une vidéo."
        }
      ],
      "expo-file-system",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": true
        }
      ],
      "./plugins/withReleaseSigning.js",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Autorise l'accès aux mouvements pour compter tes pas pendant la reconnaissance du parcours et calculer les distances entre les obstacles."
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "hidden": true
      },
      "expo-status-bar": {
        "hidden": true
      },
      "eas": {
        "projectId": "2bcded99-f727-4fc0-9a2c-fc8c191b9430"
      }
    },
    "owner": "sogerg",
    "locales": {
      "ar": "./locales/ar.json",
      "cs": "./locales/cs.json",
      "da": "./locales/da.json",
      "de": "./locales/de.json",
      "el": "./locales/el.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "fi": "./locales/fi.json",
      "fr": "./locales/fr.json",
      "hi": "./locales/hi.json",
      "hu": "./locales/hu.json",
      "it": "./locales/it.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "nl": "./locales/nl.json",
      "no": "./locales/no.json",
      "pl": "./locales/pl.json",
      "pt": "./locales/pt.json",
      "ro": "./locales/ro.json",
      "ru": "./locales/ru.json",
      "sv": "./locales/sv.json",
      "th": "./locales/th.json",
      "tr": "./locales/tr.json",
      "vi": "./locales/vi.json",
      "zh": "./locales/zh.json"
    }
  }
}
